{
  "name": "transferya",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/dev-server.js",
    "dev": "node scripts/dev-server.js",
    "dev:vercel": "vercel dev --listen 3000 --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/styles/tailwind.input.css -o ./public/css/app.css --minify",
    "build": "npm run build:css && tsc"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^22.13.1",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "web-push": "^4.0.0"
  }
}
